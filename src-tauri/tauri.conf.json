{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mesh Avatar Studio",
  "version": "0.1.0",
  "identifier": "io.github.kalcifertolueno.meshavatarstudio",
  "build": {
    "frontendDist": "shell",
    "beforeBuildCommand": "npm run desktop:web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
